{
    "name": "@glazeen/cli",
    "version": "1.0.0",
    "description": "CLI to scaffold Glazeen standard projects",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "prepublishOnly": "pnpm build"
    },
    "author": "Glazeen",
    "license": "ISC",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "@glazeen/cli": "dist/index.js",
        "glazeen-cli": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "chalk": "^5.6.2",
        "commander": "^14.0.2",
        "execa": "^9.6.0",
        "fs-extra": "^11.3.2",
        "gradient-string": "^3.0.0",
        "handlebars": "^4.7.8"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/handlebars": "^4.1.0",
        "@types/node": "^24.10.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
