{
    "name": "@glazeen/cli",
    "version": "1.2.0",
    "description": "CLI to scaffold Glazeen standard projects",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "prepublishOnly": "pnpm build",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "author": "Glazeen",
    "license": "ISC",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "@glazeen/cli": "dist/index.js",
        "glazeen-cli": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@changesets/cli": "^2.29.7",
        "chalk": "^5.6.2",
        "commander": "^14.0.2",
        "env-paths": "^3.0.0",
        "execa": "^9.6.0",
        "fs-extra": "^11.3.2",
        "gradient-string": "^3.0.0",
        "handlebars": "^4.7.8",
        "log-update": "^7.0.1",
        "ora": "^9.0.0",
        "simple-git": "^3.30.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/handlebars": "^4.1.0",
        "@types/node": "^24.10.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
