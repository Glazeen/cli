{
    "name": "@glazeen/cli",
    "version": "1.5.0",
    "description": "CLI to scaffold projects from Glazeen templates or your own template repositories",
    "type": "module",
    "bin": {
        "@glazeen/cli": "dist/index.js",
        "glazeen-cli": "dist/index.js"
    },
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.12"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "typecheck": "tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "prepublishOnly": "pnpm typecheck && pnpm build",
        "changeset": "changeset",
        "version": "changeset version && node scripts/wrappers.mjs sync",
        "release": "pnpm typecheck && pnpm build && changeset publish && node scripts/wrappers.mjs publish"
    },
    "keywords": [
        "cli",
        "scaffold",
        "template",
        "boilerplate",
        "generator",
        "glazeen"
    ],
    "author": "Glazeen (https://glazeen.ai)",
    "homepage": "https://glazeen.ai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Glazeen/cli.git"
    },
    "bugs": {
        "url": "https://github.com/Glazeen/cli/issues"
    },
    "license": "ISC",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@clack/prompts": "^1.8.1",
        "@types/node": "^24.10.0",
        "commander": "^14.0.2",
        "env-paths": "^3.0.0",
        "esbuild": "^0.28.2",
        "handlebars": "^4.7.8",
        "picocolors": "^1.1.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "zod": "^4.3.5"
    }
}
